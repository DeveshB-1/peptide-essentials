    <!-- About and first launch -->
    <string name="about">About</string>
    <string name="version">Version %1$s</string>
    <string name="not_medical_advice_title">Not medical advice</string>
    <string name="not_medical_advice_body">Dose Log is a personal log. It doesn\'t recommend medications, doses, schedules or injection sites, and it isn\'t a medical device. Always follow the instructions from your prescriber or pharmacist, and ask them if you\'re unsure about a dose.</string>
    <string name="about_data_title">Your data</string>
    <string name="about_data_body">Everything you enter is stored only on this device. Dose Log has no internet access, no accounts, no ads and no analytics. Nothing leaves your phone unless you export or back it up yourself.</string>
    <string name="about_reminders_title">Reminders</string>
    <string name="about_reminders_body">Reminders use battery-friendly alarms, so they can arrive a few minutes late. Keep notifications allowed for Dose Log, and don\'t rely on the app as your only reminder for time-critical doses.</string>
    <string name="about_sites_title">Injection sites</string>
    <string name="about_sites_body">The suggested site is simply the one you\'ve used least recently for that medication. Use only the sites your prescriber or pharmacist has shown you.</string>
    <string name="about_backup_title">Export and backup</string>
    <string name="about_backup_body">Export history as a CSV file to share with your care team, or save a backup file and restore it later or on another phone. You choose where files go.</string>
    <string name="welcome_title">Welcome to Dose Log</string>
    <string name="welcome_body">Dose Log is a personal log for medication you\'ve been prescribed. It is not medical advice and doesn\'t recommend doses or injection sites. Always follow your prescriber\'s or pharmacist\'s instructions.</string>
    <string name="welcome_privacy">Everything you enter stays on this device. The app has no internet access.</string>
    <string name="i_understand">I understand</string>
